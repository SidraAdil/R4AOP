Package: R4AOP
Title: Access the AOP-Wiki Through Its REST API
Version: 0.99.0
Authors@R: c(
    person("Sidra", "Adil", email = "sidraadil009@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-3044-3561")),
    person("Marvin", "Martens", email = "marvin.martens@maastrichtuniversity.nl",
